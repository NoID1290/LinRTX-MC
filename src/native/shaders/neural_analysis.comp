#version 450
layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) uniform sampler2D uColorTex;
layout(set = 0, binding = 1) uniform sampler2D uDepthTex;
layout(set = 0, binding = 2) uniform sampler2D uMvecTex;
layout(set = 0, binding = 3) uniform sampler2D uPrevStatsTex;

layout(set = 0, binding = 4) writeonly uniform image2D uOutStatsImg;

layout(push_constant) uniform PushConstants {
    uint workWidth;
    uint workHeight;
    uint resetHistory;
    uint inputIsHdr;
    uint reverseZ;
    uint useAutoMask;
    uint presetMode;      // 0 = Auto, 1 = Quality, 2 = Small/Fast
    float nearPlane;
    float farPlane;
    float temporalBlend;
} pc;

vec3 sanitizeVec3(vec3 c) {
    return vec3(
        (isnan(c.r) || isinf(c.r)) ? 0.0 : clamp(c.r, 0.0, 65504.0),
        (isnan(c.g) || isinf(c.g)) ? 0.0 : clamp(c.g, 0.0, 65504.0),
        (isnan(c.b) || isinf(c.b)) ? 0.0 : clamp(c.b, 0.0, 65504.0)
    );
}

vec3 srgbToLinear(vec3 c) {
    c = clamp(c, 0.0, 1.0);
    bvec3 cutoff = lessThanEqual(c, vec3(0.04045));
    vec3 low = c / 12.92;
    vec3 high = pow((c + 0.055) / 1.055, vec3(2.4));
    return mix(high, low, cutoff);
}

float luminance(vec3 c) {
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

bool isSkyDepth(float rawDepth) {
    return (pc.reverseZ != 0u) ? (rawDepth <= 1e-6) : (rawDepth >= 1.0 - 1e-6);
}

float linearizeDepth(float rawDepth) {
    float n = max(pc.nearPlane, 0.01);
    float f = max(pc.farPlane, n + 1.0);
    float z = clamp(rawDepth, 0.0, 1.0);
    if (pc.reverseZ != 0u) {
        return (n * f) / max(1e-6, z * (f - n) + n);
    }
    return (n * f) / max(1e-6, f - z * (f - n));
}

vec3 readLinear(vec2 uv) {
    vec3 c = sanitizeVec3(textureLod(uColorTex, clamp(uv, 0.0, 1.0), 0.0).rgb);
    return (pc.inputIsHdr != 0u) ? c : srgbToLinear(c);
}

void main() {
    uvec2 px = gl_GlobalInvocationID.xy;
    if (px.x >= pc.workWidth || px.y >= pc.workHeight) return;

    vec2 invRes = 1.0 / vec2(float(pc.workWidth), float(pc.workHeight));
    vec2 uv = (vec2(px) + 0.5) * invRes;

    vec3 centerLin = readLinear(uv);
    float centerLuma = luminance(centerLin);
    float centerLog = log2(max(centerLuma, 1e-4));

    float rawDepth = textureLod(uDepthTex, uv, 0.0).r;
    bool sky = isSkyDepth(rawDepth);
    float zCurr = sky ? pc.farPlane : linearizeDepth(rawDepth);

    // Resolution-proportional multi-scale radius so macro illumination & contact AO
    // scale consistently from 720p up to 4K instead of shrinking to a few pixels.
    float resScale = max(float(pc.workHeight) / 1080.0, 0.65);

    // 1. Wide multi-scale illumination field (2px .. 56px scaled) + screen-space depth contact AO.
    const vec2 kDirs[8] = vec2[](
        vec2( 1.000,  0.000), vec2(-1.000,  0.000),
        vec2( 0.000,  1.000), vec2( 0.000, -1.000),
        vec2( 0.707,  0.707), vec2(-0.707,  0.707),
        vec2( 0.707, -0.707), vec2(-0.707, -0.707)
    );

    // Estimate local tangent depth slope so slanted surfaces (floors/walls) do not self-occlude.
    float zR = linearizeDepth(textureLod(uDepthTex, clamp(uv + vec2(invRes.x, 0.0), 0.0, 1.0), 0.0).r);
    float zL = linearizeDepth(textureLod(uDepthTex, clamp(uv - vec2(invRes.x, 0.0), 0.0, 1.0), 0.0).r);
    float zD = linearizeDepth(textureLod(uDepthTex, clamp(uv + vec2(0.0, invRes.y), 0.0, 1.0), 0.0).r);
    float zU = linearizeDepth(textureLod(uDepthTex, clamp(uv - vec2(0.0, invRes.y), 0.0, 1.0), 0.0).r);
    float dzdx = (abs(zR - zCurr) < abs(zCurr - zL)) ? (zR - zCurr) : (zCurr - zL);
    float dzdy = (abs(zD - zCurr) < abs(zCurr - zU)) ? (zD - zCurr) : (zCurr - zU);

    float sumLog = centerLog * 1.25;
    float sumWeight = 1.25;
    float aoAccum = 0.0;
    float aoSamples = 0.0;

    // Ring 1 (near contact AO + local lighting, ~5px) and Ring 2 (mid-scale bounce, ~18px)
    const float kRadiiFast[2] = float[](5.0, 18.0);
    const float kRadiiFull[3] = float[](5.0, 18.0, 48.0);
    int ringCount = (pc.presetMode == 2u) ? 2 : 3;

    for (int r = 0; r < ringCount; ++r) {
        float radPx = ((pc.presetMode == 2u) ? kRadiiFast[r] : kRadiiFull[r]) * resScale;
        float ringLogW = (r == 0) ? 0.90 : ((r == 1) ? 0.75 : 0.60);
        float aoRange = max(0.35, zCurr * (0.045 + 0.04 * float(r)));

        for (int d = 0; d < 8; ++d) {
            if (r == 2 && (d & 1) == 1) continue; // 4 wide cardinal/diagonal probes on outer ring
            vec2 offsetPx = kDirs[d] * radPx;
            vec2 suv = clamp(uv + offsetPx * invRes, 0.0, 1.0);

            float sRawD = textureLod(uDepthTex, suv, 0.0).r;
            bool sSky = isSkyDepth(sRawD);
            float sZ = sSky ? pc.farPlane : linearizeDepth(sRawD);

            // Wide edge-preserving illumination average (stays on similar depth surfaces)
            float sLuma = luminance(readLinear(suv));
            float sLog = log2(max(sLuma, 1e-4));
            float relDz = abs(sZ - zCurr) / max(zCurr, 0.4);
            float wZ = exp(-relDz * (r == 2 ? 2.0 : 3.5));
            float w = wZ * ringLogW;
            sumLog += sLog * w;
            sumWeight += w;

            // Screen-space contact ambient occlusion: neighbor closer than tangent plane occludes center
            if (!sky && !sSky && r < 2) {
                float expectedZ = zCurr + dzdx * offsetPx.x + dzdy * offsetPx.y;
                float dz = expectedZ - sZ; // positive => neighbor is closer to camera (occluder)
                float bias = max(0.035, zCurr * 0.008);
                if (dz > bias && dz < aoRange) {
                    float falloff = 1.0 - smoothstep(aoRange * 0.25, aoRange, dz);
                    float strength = smoothstep(bias, bias + aoRange * 0.30, dz) * falloff;
                    aoAccum += strength;
                }
                aoSamples += 1.0;
            }
        }
    }

    float localLogLuma = sumLog / max(sumWeight, 1e-4);
    float contactAO = (aoSamples > 0.5 && !sky)
        ? clamp(1.0 - (aoAccum / aoSamples) * 1.45, 0.22, 1.0)
        : 1.0;

    // 2. Heuristic auto-mask: attenuate processing on sky & fast disocclusions
    vec2 mv = textureLod(uMvecTex, uv, 0.0).rg;
    float mvMag = length(mv * vec2(float(pc.workWidth), float(pc.workHeight)));
    float autoMask = 1.0;
    if (pc.useAutoMask != 0u) {
        float skyMask = sky ? 0.20 : 1.0;
        float motionMask = 1.0 - 0.25 * smoothstep(6.0, 32.0, mvMag);
        autoMask = skyMask * motionMask;
    }

    // 3. Temporal stabilization via backward motion vectors (eliminates AO/relight flicker)
    vec2 prevUv = uv + mv;
    bool validHist = (pc.resetHistory == 0u) &&
                     prevUv.x >= 0.0 && prevUv.x <= 1.0 &&
                     prevUv.y >= 0.0 && prevUv.y <= 1.0;

    if (validHist) {
        vec4 prev = textureLod(uPrevStatsTex, prevUv, 0.0);
        float zPrev = prev.a;
        float relDz = abs(zPrev - zCurr) / max(zCurr, 0.25);
        if (zPrev > 0.0 && !isnan(prev.r) && !isinf(prev.r) && relDz < 0.16) {
            float alpha = clamp(pc.temporalBlend, 0.0, 0.90) * (1.0 - 0.55 * smoothstep(2.0, 20.0, mvMag));
            localLogLuma = mix(localLogLuma, clamp(prev.r, localLogLuma - 1.5, localLogLuma + 1.5), alpha);
            contactAO = mix(contactAO, clamp(prev.g, 0.22, 1.0), alpha * 0.88);
            autoMask = mix(autoMask, clamp(prev.b, 0.0, 1.0), alpha * 0.75);
        } else if (pc.useAutoMask != 0u) {
            autoMask *= 0.78;
        }
    }

    imageStore(uOutStatsImg, ivec2(px), vec4(localLogLuma, contactAO, autoMask, zCurr));
}
