#version 450
layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) uniform sampler2D uInputTex;
layout(set = 0, binding = 1) writeonly uniform image2D uOutputImg;

layout(push_constant) uniform PushConstants {
    uint width;
    uint height;
    float sharpness; // 0.0 .. 1.0
    uint pad;
} pc;

float getLuma(vec3 c) {
    return dot(c, vec3(0.299, 0.587, 0.114));
}

void main() {
    uvec2 px = gl_GlobalInvocationID.xy;
    if (px.x >= pc.width || px.y >= pc.height) return;

    ivec2 ipx = ivec2(px);
    ivec2 maxCoord = ivec2(pc.width - 1u, pc.height - 1u);

    vec4 c = texelFetch(uInputTex, ipx, 0);
    if (pc.sharpness <= 0.001) {
        imageStore(uOutputImg, ipx, c);
        return;
    }

    vec3 n = texelFetch(uInputTex, clamp(ipx + ivec2(0, -1), ivec2(0), maxCoord), 0).rgb;
    vec3 s = texelFetch(uInputTex, clamp(ipx + ivec2(0,  1), ivec2(0), maxCoord), 0).rgb;
    vec3 w = texelFetch(uInputTex, clamp(ipx + ivec2(-1, 0), ivec2(0), maxCoord), 0).rgb;
    vec3 e = texelFetch(uInputTex, clamp(ipx + ivec2( 1, 0), ivec2(0), maxCoord), 0).rgb;

    vec3 minRgb = min(c.rgb, min(min(n, s), min(w, e)));
    vec3 maxRgb = max(c.rgb, max(max(n, s), max(w, e)));

    // Robust Contrast-Adaptive Sharpening weight
    vec3 dMin = minRgb;
    vec3 dMax = max(1.0 - maxRgb, vec3(0.0));
    vec3 amp = clamp(min(dMin, dMax) / max(maxRgb, vec3(1e-4)), 0.0, 1.0);
    amp = sqrt(amp);

    float peak = -1.0 / mix(8.0, 5.0, clamp(pc.sharpness, 0.0, 1.0));
    vec3 wgt = amp * peak;
    vec3 rcpWeight = 1.0 / (1.0 + 4.0 * wgt);

    vec3 outRgb = clamp((c.rgb + (n + s + w + e) * wgt) * rcpWeight, 0.0, 65504.0);
    imageStore(uOutputImg, ipx, vec4(outRgb, c.a));
}
