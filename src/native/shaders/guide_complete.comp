#version 450
layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) uniform sampler2D uColorTex;
layout(set = 0, binding = 1) uniform sampler2D uDepthTex;
layout(set = 0, binding = 2) uniform sampler2D uAlbedoOptTex;
layout(set = 0, binding = 3) uniform sampler2D uNormalsOptTex;

layout(set = 0, binding = 4) writeonly uniform image2D uOutDiffuseAlbedo;
layout(set = 0, binding = 5) writeonly uniform image2D uOutSpecularAlbedo;
layout(set = 0, binding = 6) writeonly uniform image2D uOutNormals;
layout(set = 0, binding = 7) writeonly uniform image2D uOutRoughness;

layout(push_constant) uniform PushConstants {
    uint width;
    uint height;
    uint hasAlbedo;
    uint hasNormals;
    uint normalsAreWorld;
    uint normalsPacked01;
    uint reverseZ;
    float nearPlane;
    float farPlane;
    uint pad0;
    uint pad1;
    uint pad2;
    vec4 viewRow0;
    vec4 viewRow1;
    vec4 viewRow2;
} pc;

float linearizeDepth(float d) {
    float n = max(pc.nearPlane, 0.01);
    float f = max(pc.farPlane, n + 1.0);
    if (pc.reverseZ != 0u) {
        return (n * f) / max(n + d * (f - n), 1e-6);
    }
    return (n * f) / max(f - d * (f - n), 1e-6);
}

bool isSkyDepth(float d) {
    return (pc.reverseZ != 0u) ? (d <= 1e-6) : (d >= 0.999999);
}

vec3 safeColor(ivec2 px) {
    vec3 c = texelFetch(uColorTex, px, 0).rgb;
    bvec3 bad = bvec3(isnan(c.x) || isinf(c.x),
                      isnan(c.y) || isinf(c.y),
                      isnan(c.z) || isinf(c.z));
    return mix(max(c, vec3(0.0)), vec3(0.0), bad);
}

vec3 depthViewNormal(ivec2 ipx) {
    int maxX = max(int(pc.width) - 1, 0);
    int maxY = max(int(pc.height) - 1, 0);
    float zC = linearizeDepth(texelFetch(uDepthTex, ipx, 0).r);
    float zR = linearizeDepth(texelFetch(uDepthTex, ivec2(min(ipx.x + 1, maxX), ipx.y), 0).r);
    float zL = linearizeDepth(texelFetch(uDepthTex, ivec2(max(ipx.x - 1, 0), ipx.y), 0).r);
    float zD = linearizeDepth(texelFetch(uDepthTex, ivec2(ipx.x, min(ipx.y + 1, maxY)), 0).r);
    float zU = linearizeDepth(texelFetch(uDepthTex, ivec2(ipx.x, max(ipx.y - 1, 0)), 0).r);

    float dzdx = (abs(zR - zC) < abs(zC - zL)) ? (zR - zC) : (zC - zL);
    float dzdy = (abs(zD - zC) < abs(zC - zU)) ? (zD - zC) : (zC - zU);
    float scale = max(zC * 0.0025, 1e-4);
    vec3 n = vec3(-dzdx, dzdy, scale);
    float len2 = dot(n, n);
    return (len2 > 1e-10) ? (n * inversesqrt(len2)) : vec3(0.0, 0.0, 1.0);
}

void main() {
    uvec2 px = gl_GlobalInvocationID.xy;
    if (px.x >= pc.width || px.y >= pc.height) return;

    ivec2 ipx = ivec2(px);
    float d = texelFetch(uDepthTex, ipx, 0).r;
    bool sky = isSkyDepth(d);

    vec3 diffAlb = vec3(0.0);
    if (!sky) {
        if (pc.hasAlbedo != 0u) {
            vec3 a = texelFetch(uAlbedoOptTex, ipx, 0).rgb;
            bvec3 bad = bvec3(isnan(a.x) || isinf(a.x),
                              isnan(a.y) || isinf(a.y),
                              isnan(a.z) || isinf(a.z));
            diffAlb = clamp(mix(a, vec3(0.0), bad), vec3(0.0), vec3(1.0));
        } else {
            vec3 col = safeColor(ipx);
            vec3 tone = col / (vec3(1.0) + col);
            diffAlb = clamp(tone * 0.85, vec3(0.03), vec3(0.95));
        }
    }

    vec3 viewN = vec3(0.0, 0.0, 1.0);
    bool isWater = false;
    if (!sky) {
        if (pc.hasNormals != 0u) {
            vec4 rawN = texelFetch(uNormalsOptTex, ipx, 0);
            isWater = (rawN.a > 1.5);
            vec3 n = (pc.normalsPacked01 != 0u) ? (rawN.xyz * 2.0 - 1.0) : rawN.xyz;
            if (any(isnan(n)) || any(isinf(n)) || dot(n, n) < 1e-6) {
                viewN = depthViewNormal(ipx);
            } else {
                n = normalize(n);
                if (pc.normalsAreWorld != 0u) {
                    vec3 v = vec3(dot(pc.viewRow0.xyz, n),
                                  dot(pc.viewRow1.xyz, n),
                                  dot(pc.viewRow2.xyz, n));
                    viewN = (dot(v, v) > 1e-6) ? normalize(v) : vec3(0.0, 0.0, 1.0);
                } else {
                    viewN = n;
                }
            }
        } else {
            viewN = depthViewNormal(ipx);
        }
    }

    vec3 specAlb = vec3(0.0);
    float rough = 1.0;
    if (!sky) {
        if (isWater) {
            diffAlb = mix(diffAlb, vec3(0.02, 0.05, 0.06), 0.70);
            specAlb = vec3(0.025);
            rough = 0.06;
        } else {
            float luma = dot(diffAlb, vec3(0.2126, 0.7152, 0.0722));
            specAlb = vec3(mix(0.04, 0.09, clamp(luma, 0.0, 1.0)));
            rough = mix(0.82, 0.42, clamp(luma, 0.0, 1.0));
        }
    }

    imageStore(uOutDiffuseAlbedo, ipx, vec4(diffAlb, 1.0));
    imageStore(uOutSpecularAlbedo, ipx, vec4(specAlb, 1.0));
    imageStore(uOutNormals, ipx, vec4(viewN, 1.0));
    imageStore(uOutRoughness, ipx, vec4(rough, 0.0, 0.0, 1.0));
}
