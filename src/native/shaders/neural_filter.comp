#version 450
layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) uniform sampler2D uColorTex;
layout(set = 0, binding = 1) uniform sampler2D uDepthTex;
layout(set = 0, binding = 2) uniform sampler2D uMvecTex;
layout(set = 0, binding = 3) uniform sampler2D uWorkStatsTex;

layout(set = 0, binding = 4) writeonly uniform image2D uOutColorImg;

layout(push_constant) uniform PushConstants {
    uint width;
    uint height;
    uint style;                  // 0 = Default, 1 = Natural, 2 = Cinematic
    uint presetMode;             // 0 = Auto, 1 = Quality, 2 = Small/Fast
    uint inputIsHdr;             // 0 = sRGB SDR, 1 = linear HDR FP16
    uint reverseZ;
    uint useAutoMask;
    uint frameIndex;
    float nearPlane;
    float farPlane;
    float intensity;             // 0.0 .. 2.0
    float localToneStrength;     // 0.0 .. 2.0
    float localStructureStrength;// 0.0 .. 2.0
    float skinStructureStrength; // -1.0 (Auto) or 0.0 .. 2.0
} pc;

vec3 sanitizeVec3(vec3 c) {
    return vec3(
        (isnan(c.r) || isinf(c.r)) ? 0.0 : clamp(c.r, 0.0, 65504.0),
        (isnan(c.g) || isinf(c.g)) ? 0.0 : clamp(c.g, 0.0, 65504.0),
        (isnan(c.b) || isinf(c.b)) ? 0.0 : clamp(c.b, 0.0, 65504.0)
    );
}

vec3 srgbToLinear(vec3 c) {
    c = clamp(c, 0.0, 1.0);
    bvec3 cutoff = lessThanEqual(c, vec3(0.04045));
    vec3 low = c / 12.92;
    vec3 high = pow((c + 0.055) / 1.055, vec3(2.4));
    return mix(high, low, cutoff);
}

vec3 linearToSrgb(vec3 c) {
    c = clamp(c, 0.0, 1.0);
    bvec3 cutoff = lessThanEqual(c, vec3(0.0031308));
    vec3 low = c * 12.92;
    vec3 high = 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055;
    return mix(high, low, cutoff);
}

float luminance(vec3 c) {
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

bool isSkyDepth(float rawDepth) {
    return (pc.reverseZ != 0u) ? (rawDepth <= 1e-6) : (rawDepth >= 1.0 - 1e-6);
}

float linearizeDepth(float rawDepth) {
    float n = max(pc.nearPlane, 0.01);
    float f = max(pc.farPlane, n + 1.0);
    float z = clamp(rawDepth, 0.0, 1.0);
    if (pc.reverseZ != 0u) {
        return (n * f) / max(1e-6, z * (f - n) + n);
    }
    return (n * f) / max(1e-6, f - z * (f - n));
}

vec3 fetchLinear(ivec2 coord, ivec2 maxCoord) {
    vec3 c = sanitizeVec3(texelFetch(uColorTex, clamp(coord, ivec2(0), maxCoord), 0).rgb);
    return (pc.inputIsHdr != 0u) ? c : srgbToLinear(c);
}

float hash12(vec2 p) {
    vec3 p3 = fract(vec3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

float tpdfDither(uvec2 coord, uint frame) {
    vec2 s = vec2(coord) + vec2(float(frame & 255u) * 1.71, float((frame >> 8) & 255u) * 2.13);
    return hash12(s) - hash12(s + vec2(17.3, 41.9));
}

// Smooth warm-hue / moderate-saturation organic skin-tone confidence heuristic [0..1]
float computeOrganicSkinMask(vec3 lin) {
    float mx = max(lin.r, max(lin.g, lin.b));
    float mn = min(lin.r, min(lin.g, lin.b));
    float luma = luminance(lin);
    if (mx < 0.02 || luma > 0.92) return 0.0;
    float sat = (mx - mn) / max(mx, 1e-4);
    float warmBias = smoothstep(0.0, 0.14, lin.r - lin.b) * smoothstep(-0.02, 0.08, lin.r - lin.g);
    float satBand = smoothstep(0.10, 0.24, sat) * (1.0 - smoothstep(0.55, 0.78, sat));
    float lumaBand = smoothstep(0.03, 0.12, luma) * (1.0 - smoothstep(0.65, 0.95, luma));
    return clamp(warmBias * satBand * lumaBand, 0.0, 1.0);
}

// Reconstruct approximate view-space normal from reverse-Z depth for directional material sheen
vec3 reconstructDepthNormal(vec2 uv, vec2 invRes, float zC) {
    float zR = linearizeDepth(textureLod(uDepthTex, clamp(uv + vec2(invRes.x, 0.0), 0.0, 1.0), 0.0).r);
    float zL = linearizeDepth(textureLod(uDepthTex, clamp(uv - vec2(invRes.x, 0.0), 0.0, 1.0), 0.0).r);
    float zD = linearizeDepth(textureLod(uDepthTex, clamp(uv + vec2(0.0, invRes.y), 0.0, 1.0), 0.0).r);
    float zU = linearizeDepth(textureLod(uDepthTex, clamp(uv - vec2(0.0, invRes.y), 0.0, 1.0), 0.0).r);
    float dzdx = (abs(zR - zC) < abs(zC - zL)) ? (zR - zC) : (zC - zL);
    float dzdy = (abs(zD - zC) < abs(zC - zU)) ? (zD - zC) : (zC - zU);
    float scale = max(zC * 0.0032, 1e-4);
    vec3 n = vec3(-dzdx, dzdy, scale);
    float l2 = dot(n, n);
    return (l2 > 1e-10) ? (n * inversesqrt(l2)) : vec3(0.0, 0.0, 1.0);
}

// Soft filmic highlight roll-off (preserves color ratios without hard clipping)
vec3 softShoulder(vec3 c) {
    float l = luminance(c);
    if (l <= 0.85) return c;
    float mapped = 0.85 + (l - 0.85) / (1.0 + (l - 0.85) * 1.15);
    return c * (mapped / max(l, 1e-5));
}

void main() {
    uvec2 px = gl_GlobalInvocationID.xy;
    if (px.x >= pc.width || px.y >= pc.height) return;

    ivec2 ipx = ivec2(px);
    ivec2 maxCoord = ivec2(int(pc.width) - 1, int(pc.height) - 1);
    vec4 rawCenter = texelFetch(uColorTex, ipx, 0);

    if (pc.intensity <= 0.001) {
        imageStore(uOutColorImg, ipx, rawCenter);
        return;
    }

    vec3 centerSan = sanitizeVec3(rawCenter.rgb);
    vec3 centerLin = (pc.inputIsHdr != 0u) ? centerSan : srgbToLinear(centerSan);
    float centerLuma = luminance(centerLin);

    vec2 invRes = 1.0 / vec2(float(pc.width), float(pc.height));
    vec2 uv = (vec2(ipx) + 0.5) * invRes;
    vec4 stats = textureLod(uWorkStatsTex, uv, 0.0);
    float localLogLuma = stats.r;
    float contactAO = clamp(stats.g, 0.22, 1.0);
    float autoMask = (pc.useAutoMask != 0u) ? clamp(stats.b, 0.15, 1.0) : 1.0;

    float rawDepth = textureLod(uDepthTex, uv, 0.0).r;
    bool sky = isSkyDepth(rawDepth);
    float zCenter = sky ? pc.farPlane : linearizeDepth(rawDepth);

    // Style-specific neural relighting, AO, material relief, and color grading parameters
    // 0 = Default (Neural Relight), 1 = Natural (Organic GI), 2 = Cinematic (Filmic Grade)
    float toneStyleScale = 1.00;
    float structStyleScale = 0.85;
    float aoStrength = 0.65;
    float sheenStrength = 0.22;
    float satBoost = 1.12;
    float filmicContrast = 0.16;
    float shadowFill = 0.12;
    vec3 shadowTint = vec3(0.94, 0.98, 1.07);
    vec3 highTint = vec3(1.06, 1.01, 0.94);
    float hazeStrength = 0.04;
    vec3 hazeColor = vec3(0.32, 0.42, 0.56);

    if (pc.style == 1u) {
        // Natural: warm organic GI shadow lift, soft contact occlusion, lush sunlit vibrancy
        toneStyleScale = 0.92;
        structStyleScale = 0.68;
        aoStrength = 0.50;
        sheenStrength = 0.16;
        satBoost = 1.18;
        filmicContrast = 0.08;
        shadowFill = 0.24;
        shadowTint = vec3(1.02, 1.01, 0.97);
        highTint = vec3(1.08, 1.03, 0.94);
        hazeStrength = 0.05;
        hazeColor = vec3(0.42, 0.48, 0.55);
    } else if (pc.style == 2u) {
        // Cinematic: dramatic deep-shadow contact AO, bold local lighting contrast, warm/cool split
        toneStyleScale = 1.38;
        structStyleScale = 1.05;
        aoStrength = 0.90;
        sheenStrength = 0.34;
        satBoost = 1.16;
        filmicContrast = 0.28;
        shadowFill = 0.05;
        shadowTint = vec3(0.86, 0.95, 1.14);
        highTint = vec3(1.12, 1.01, 0.88);
        hazeStrength = 0.08;
        hazeColor = vec3(0.24, 0.34, 0.48);
    }

    // 1. Edge-preserving micro-structure decomposition (for smooth material relief without aliasing)
    vec3 baseAccum = centerLin;
    float baseWeight = 1.0;
    float maxDeltaLuma = 0.0;

    const ivec2 kCardinals[4] = ivec2[](
        ivec2(-1, 0), ivec2(1, 0), ivec2(0, -1), ivec2(0, 1)
    );
    const ivec2 kDiagonals[4] = ivec2[](
        ivec2(-1, -1), ivec2(1, -1), ivec2(-1, 1), ivec2(1, 1)
    );

    float lumaSigma = max(0.045, centerLuma * 0.32);

    for (int i = 0; i < 4; ++i) {
        ivec2 sc = clamp(ipx + kCardinals[i], ivec2(0), maxCoord);
        vec3 s = fetchLinear(sc, maxCoord);
        float dL = abs(luminance(s) - centerLuma);
        maxDeltaLuma = max(maxDeltaLuma, dL);

        vec2 suv = (vec2(sc) + 0.5) * invRes;
        float sRawD = textureLod(uDepthTex, suv, 0.0).r;
        float sZ = isSkyDepth(sRawD) ? pc.farPlane : linearizeDepth(sRawD);
        float wZ = exp(-(abs(sZ - zCenter) / max(zCenter, 0.25)) * 12.0);
        float wL = exp(-(dL * dL) / (2.0 * lumaSigma * lumaSigma));
        float w = wZ * wL * 0.65;
        baseAccum += s * w;
        baseWeight += w;
    }

    if (pc.presetMode != 2u) {
        for (int i = 0; i < 4; ++i) {
            ivec2 sc = clamp(ipx + kDiagonals[i], ivec2(0), maxCoord);
            vec3 s = fetchLinear(sc, maxCoord);
            float dL = abs(luminance(s) - centerLuma);
            maxDeltaLuma = max(maxDeltaLuma, dL);

            vec2 suv = (vec2(sc) + 0.5) * invRes;
            float sRawD = textureLod(uDepthTex, suv, 0.0).r;
            float sZ = isSkyDepth(sRawD) ? pc.farPlane : linearizeDepth(sRawD);
            float wZ = exp(-(abs(sZ - zCenter) / max(zCenter, 0.25)) * 12.0);
            float wL = exp(-(dL * dL) / (2.0 * lumaSigma * lumaSigma));
            float w = wZ * wL * 0.40;
            baseAccum += s * w;
            baseWeight += w;
        }
    }

    vec3 localBase = baseAccum / max(baseWeight, 1e-4);
    vec3 detail = centerLin - localBase;

    // 2. Wide-radius Neural Relighting + Contact AO + Bounced Shadow Fill
    float centerLog = log2(max(centerLuma, 1e-4));
    float localDiff = clamp(centerLog - localLogLuma, -2.5, 2.5);
    float toneStrength = clamp(pc.localToneStrength, 0.0, 2.0) * toneStyleScale * autoMask;

    // Macro local light-vs-shadow contrast + gentle GI fill in unoccluded shadows
    float openShadowMask = smoothstep(-4.2, -1.2, -centerLog) * contactAO * (1.0 - smoothstep(0.45, 1.10, centerLuma));
    float toneGainLog = localDiff * (0.42 * toneStrength)
                      + (shadowFill * toneStrength) * openShadowMask;

    // Filmic midtone S-curve around local ambient log luminance
    float midContrast = clamp(centerLog - localLogLuma, -1.6, 1.6);
    toneGainLog += midContrast * filmicContrast * autoMask;

    float hiProt = 1.0 - 0.55 * smoothstep(0.75, 1.85, centerLuma);
    float toneScale = exp2(clamp(toneGainLog * hiProt, -1.15, 1.15));

    // Crevice contact ambient occlusion (deepens block joints, foliage interiors, under overhangs)
    float aoFactor = sky ? 1.0 : mix(1.0, contactAO, clamp(aoStrength * toneStrength, 0.0, 1.0));
    vec3 relitBase = localBase * toneScale * aoFactor;

    // 3. Depth-Normal Directional Material Lighting & Grazing Fresnel Specular Sheen
    if (!sky && sheenStrength > 0.001) {
        vec3 viewN = reconstructDepthNormal(uv, invRes, zCenter);
        float ndotv = clamp(viewN.z, 0.0, 1.0);
        float fresnel = pow(1.0 - ndotv, 3.0);

        // Directional key-light relief (top-right key vs cool underside bounce)
        vec3 keyDir = normalize(vec3(0.42, 0.78, 0.46));
        float keyAlign = dot(viewN, keyDir);
        float dirRelief = 1.0 + keyAlign * (0.14 * toneStrength);
        relitBase *= clamp(dirRelief, 0.80, 1.24);

        // Grazing dielectric specular sheen weighted by local illumination & AO
        float litMask = smoothstep(0.04, 0.55, centerLuma) * contactAO;
        vec3 sheenCol = mix(vec3(1.0), highTint, 0.65);
        relitBase += sheenCol * (fresnel * sheenStrength * litMask * autoMask * 0.28);
    }

    // 4. Warm-highlight / cool-shadow split lighting tint (skips sky)
    if (!sky) {
        float tHi = smoothstep(0.06, 0.65, centerLuma);
        vec3 splitTint = mix(shadowTint, highTint, tHi);
        relitBase *= mix(vec3(1.0), splitTint, clamp(0.70 * autoMask, 0.0, 1.0));
    }

    // 5. Controlled micro-structure reconstruction (detail-only anti-ringing so relighting is NEVER clamped away!)
    float structStrength = clamp(pc.localStructureStrength, 0.0, 2.0) * structStyleScale * autoMask;
    if (pc.useAutoMask != 0u) {
        float skinMask = computeOrganicSkinMask(centerLin);
        float skinFactor = (pc.skinStructureStrength < -0.5)
            ? 0.35
            : clamp(pc.skinStructureStrength, 0.0, 2.0);
        structStrength *= mix(1.0, skinFactor, skinMask);
    }
    if (sky) {
        structStrength *= 0.08;
    }
    // Suppress structure boost on high-contrast silhouette edges so AA stays silky smooth
    float edgeDamp = 1.0 - 0.65 * smoothstep(0.18, 0.60, maxDeltaLuma);
    float detailBoost = structStrength * 0.55 * edgeDamp;
    vec3 detailAdded = clamp(detail * detailBoost, vec3(-0.08), vec3(0.08));
    vec3 filtered = max(relitBase + detail + detailAdded, vec3(0.0));

    // 6. Subtle depth-based atmospheric perspective (adds depth separation on distant terrain)
    if (!sky && hazeStrength > 0.001) {
        float distNorm = smoothstep(pc.farPlane * 0.18, pc.farPlane * 0.92, zCenter);
        float hazeAmt = distNorm * hazeStrength * autoMask;
        float envLuma = clamp(exp2(localLogLuma), 0.15, 1.25);
        filtered = mix(filtered, hazeColor * envLuma, clamp(hazeAmt, 0.0, 0.25));
    }

    // 7. Luma-preserving vibrance refinement + soft highlight shoulder
    if (abs(satBoost - 1.0) > 1e-3 && !sky) {
        float fl = luminance(filtered);
        filtered = max(mix(vec3(fl), filtered, mix(1.0, satBoost, autoMask)), vec3(0.0));
    }
    if (pc.inputIsHdr == 0u) {
        filtered = softShoulder(filtered);
    }

    // 8. Master Intensity blend (0..1 lerp, >1..2 controlled amplification)
    vec3 finalLin;
    if (pc.intensity <= 1.0) {
        finalLin = mix(centerLin, filtered, clamp(pc.intensity, 0.0, 1.0));
    } else {
        float extra = clamp(pc.intensity - 1.0, 0.0, 1.0);
        finalLin = max(filtered + (filtered - centerLin) * (extra * 0.55), vec3(0.0));
    }

    vec3 outRgb;
    if (pc.inputIsHdr != 0u) {
        outRgb = clamp(finalLin, vec3(0.0), vec3(65504.0));
    } else {
        outRgb = linearToSrgb(clamp(finalLin, vec3(0.0), vec3(1.0)));
        outRgb = clamp(outRgb + tpdfDither(px, pc.frameIndex) / 255.0, 0.0, 1.0);
    }

    imageStore(uOutColorImg, ipx, vec4(outRgb, rawCenter.a));
}
