#version 450
layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) uniform sampler2D uInputTex;
layout(set = 0, binding = 1) writeonly uniform image2D uOutputImg;

layout(push_constant) uniform PushConstants {
    uint width;
    uint height;
    uint outputMode;    // 0 = SDR_BOOST, 1 = PQ_BT2020, 2 = SCRGB_FP16
    uint inputIsHdr;    // 0 = sRGB SDR [0..1], 1 = linear HDR
    float contrast;     // 0.0 .. 2.0 (1.0 = default)
    float saturation;   // 0.0 .. 2.0 (1.0 = default)
    float middleGray;   // 0.1 .. 1.0 (0.5 = default)
    float maxNits;      // 400.0 .. 2000.0
    float highlightBoost; // 0.0 .. 2.0
    uint debandEnable;  // 1 = apply TPDF dither
    uint frameIndex;
    uint pad;
} pc;

vec3 srgbToLinear(vec3 c) {
    c = max(c, vec3(0.0));
    bvec3 cutoff = lessThanEqual(c, vec3(0.04045));
    vec3 low = c / 12.92;
    vec3 high = pow((c + 0.055) / 1.055, vec3(2.4));
    return mix(high, low, cutoff);
}

vec3 linearToSrgb(vec3 c) {
    c = clamp(c, 0.0, 1.0);
    bvec3 cutoff = lessThanEqual(c, vec3(0.0031308));
    vec3 low = c * 12.92;
    vec3 high = 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055;
    return mix(high, low, cutoff);
}

vec3 rec709ToRec2020(vec3 c) {
    // Standard ITU-R BT.709 -> BT.2020 linear matrix
    return vec3(
        0.627404 * c.r + 0.329283 * c.g + 0.043313 * c.b,
        0.069097 * c.r + 0.919540 * c.g + 0.011362 * c.b,
        0.016391 * c.r + 0.088013 * c.g + 0.895595 * c.b
    );
}

vec3 rec2020ToRec709(vec3 c) {
    return max(vec3(
         1.660491 * c.r - 0.587641 * c.g - 0.072850 * c.b,
        -0.124550 * c.r + 1.132900 * c.g - 0.008349 * c.b,
        -0.018151 * c.r - 0.100579 * c.g + 1.118730 * c.b
    ), vec3(0.0));
}

vec3 pqToLinearNits(vec3 pq) {
    pq = clamp(pq, 0.0, 1.0);
    const float m1 = 2610.0 / 16384.0;
    const float m2 = (2523.0 / 4096.0) * 128.0;
    const float c1 = 3424.0 / 4096.0;
    const float c2 = (2413.0 / 4096.0) * 32.0;
    const float c3 = (2392.0 / 4096.0) * 32.0;
    vec3 Np = pow(pq, vec3(1.0 / m2));
    vec3 num = max(Np - c1, vec3(0.0));
    vec3 den = max(c2 - c3 * Np, vec3(1e-6));
    return pow(num / den, vec3(1.0 / m1)) * 10000.0;
}

vec3 linearToPQ(vec3 linearNits) {
    vec3 Y = clamp(linearNits / 10000.0, 0.0, 1.0);
    const float m1 = 2610.0 / 16384.0;
    const float m2 = (2523.0 / 4096.0) * 128.0;
    const float c1 = 3424.0 / 4096.0;
    const float c2 = (2413.0 / 4096.0) * 32.0;
    const float c3 = (2392.0 / 4096.0) * 32.0;
    vec3 Ym1 = pow(Y, vec3(m1));
    return pow((c1 + c2 * Ym1) / (1.0 + c3 * Ym1), vec3(m2));
}

float hash12(vec2 p) {
    vec3 p3 = fract(vec3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

float tpdfDither(uvec2 coord, uint frame) {
    vec2 seed1 = vec2(coord) + vec2(float(frame & 255u) * 1.71, float((frame >> 8) & 255u) * 2.13);
    float r1 = hash12(seed1);
    float r2 = hash12(seed1 + vec2(17.3, 41.9));
    return (r1 - r2);
}

void main() {
    uvec2 px = gl_GlobalInvocationID.xy;
    if (px.x >= pc.width || px.y >= pc.height) return;

    vec4 src = texelFetch(uInputTex, ivec2(px), 0);
    float paperWhite = clamp(203.0 * (0.65 + 0.7 * pc.middleGray), 120.0, min(pc.maxNits * 0.55, 340.0));
    vec3 hdrNits;

    if (pc.inputIsHdr == 2u) {
        // Input already HDR10 PQ BT.2020 (from NVIDIA TrueHDR NGX)
        hdrNits = min(rec2020ToRec709(pqToLinearNits(src.rgb)), vec3(pc.maxNits));
    } else {
        vec3 lin = (pc.inputIsHdr == 1u) ? max(src.rgb, vec3(0.0)) : srgbToLinear(src.rgb);

        // Log-space contrast around configurable middle gray pivot
        float pivot = clamp(pc.middleGray * 0.36, 0.02, 0.45);
        float luma = max(dot(lin, vec3(0.2126, 0.7152, 0.0722)), 1e-5);
        float contrastGain = clamp(pc.contrast, 0.05, 2.0);
        float targetLuma = pivot * pow(luma / pivot, contrastGain);
        lin *= (targetLuma / luma);

        // Luma-preserving saturation adjustment
        float newLuma = dot(lin, vec3(0.2126, 0.7152, 0.0722));
        lin = max(mix(vec3(newLuma), lin, pc.saturation), vec3(0.0));

        // Smooth RTX HDR Inverse Tone-Mapping curve
        float maxChannel = max(max(lin.r, lin.g), max(lin.b, 1e-5));
        float peakRatio = pc.maxNits / max(paperWhite, 1.0);
        float boostPow = 2.0 + pc.highlightBoost * 1.35;
        float sdrClamped = min(maxChannel, 1.0);
        float expandFactor = 1.0 + (peakRatio - 1.0) * pow(smoothstep(0.45, 1.0, sdrClamped), boostPow);
        if (maxChannel > 1.0) {
            float headRoom = (maxChannel - 1.0) / (1.0 + 0.35 * (maxChannel - 1.0));
            expandFactor = mix(expandFactor, peakRatio, clamp(headRoom, 0.0, 1.0));
        }
        hdrNits = min(lin * (paperWhite * expandFactor), vec3(pc.maxNits));
    }

    vec3 outRgb;
    if (pc.outputMode == 1u) {
        // HDR10 ST.2084 PQ BT.2020
        vec3 bt2020 = max(rec709ToRec2020(hdrNits), vec3(0.0));
        outRgb = linearToPQ(bt2020);
        if (pc.debandEnable != 0u) {
            outRgb += tpdfDither(px, pc.frameIndex) / 1023.0;
        }
        outRgb = clamp(outRgb, 0.0, 1.0);
    } else if (pc.outputMode == 2u) {
        // Linear scRGB (1.0 = 80 nits)
        outRgb = hdrNits / 80.0;
    } else {
        // SDR_BOOST: soft-rolloff expanded HDR back into rich SDR sRGB display space
        vec3 normHdr = hdrNits / max(paperWhite * 1.15, 1.0);
        // Filmic ACES-like highlight rolloff preserving crisp midtones
        vec3 mapped = normHdr / (normHdr * 0.42 + 0.58);
        outRgb = linearToSrgb(mapped);
        if (pc.debandEnable != 0u) {
            outRgb = clamp(outRgb + tpdfDither(px, pc.frameIndex) / 255.0, 0.0, 1.0);
        }
    }

    imageStore(uOutputImg, ivec2(px), vec4(outRgb, src.a));
}
