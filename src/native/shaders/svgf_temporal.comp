#version 450
layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) uniform sampler2D uColorTex;
layout(set = 0, binding = 1) uniform sampler2D uDepthTex;
layout(set = 0, binding = 2) uniform sampler2D uMvecTex;
layout(set = 0, binding = 3) uniform sampler2D uAlbedoTex;
layout(set = 0, binding = 4) uniform sampler2D uNormalsTex;
layout(set = 0, binding = 5) uniform sampler2D uHistoryColorTex;
layout(set = 0, binding = 6) uniform sampler2D uHistoryMomentsTex;

layout(set = 0, binding = 7) writeonly uniform image2D uOutIrradianceImg;
layout(set = 0, binding = 8) writeonly uniform image2D uOutMomentsImg;

layout(push_constant) uniform PushConstants {
    uint width;
    uint height;
    uint resetHistory;
    uint hasAlbedo;
    uint hasNormals;
    uint normalsPacked01;
    uint demodulateAlbedo;
    uint inputIsSrgb;
    uint reverseZ;
    float nearPlane;
    float farPlane;
    float temporalBlend;
    float strength;
} pc;

vec3 sanitizeVec3(vec3 c) {
    return vec3(
        (isnan(c.r) || isinf(c.r)) ? 0.0 : clamp(c.r, 0.0, 65504.0),
        (isnan(c.g) || isinf(c.g)) ? 0.0 : clamp(c.g, 0.0, 65504.0),
        (isnan(c.b) || isinf(c.b)) ? 0.0 : clamp(c.b, 0.0, 65504.0)
    );
}

vec3 srgbToLinear(vec3 c) {
    c = clamp(c, 0.0, 1.0);
    bvec3 cutoff = lessThanEqual(c, vec3(0.04045));
    vec3 low = c / 12.92;
    vec3 high = pow((c + 0.055) / 1.055, vec3(2.4));
    return mix(high, low, cutoff);
}

float luminance(vec3 c) {
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

bool isSkyDepth(float rawDepth) {
    return (pc.reverseZ != 0u) ? (rawDepth <= 1e-6) : (rawDepth >= 1.0 - 1e-6);
}

float linearizeDepth(float rawDepth) {
    float n = max(pc.nearPlane, 0.01);
    float f = max(pc.farPlane, n + 1.0);
    float z = clamp(rawDepth, 0.0, 1.0);
    if (pc.reverseZ != 0u) {
        return (n * f) / max(1e-6, z * (f - n) + n);
    }
    return (n * f) / max(1e-6, f - z * (f - n));
}

vec3 decodeNormal(ivec2 coord) {
    if (pc.hasNormals != 0u) {
        vec3 n = texelFetch(uNormalsTex, coord, 0).xyz;
        if (pc.normalsPacked01 != 0u) {
            n = n * 2.0 - 1.0;
        }
        float len2 = dot(n, n);
        if (len2 > 1e-6 && !isnan(len2) && !isinf(len2)) {
            return n * inversesqrt(len2);
        }
    }
    ivec2 maxC = ivec2(pc.width - 1u, pc.height - 1u);
    float zc = linearizeDepth(texelFetch(uDepthTex, coord, 0).r);
    float zr = linearizeDepth(texelFetch(uDepthTex, clamp(coord + ivec2(1, 0), ivec2(0), maxC), 0).r);
    float zu = linearizeDepth(texelFetch(uDepthTex, clamp(coord + ivec2(0, 1), ivec2(0), maxC), 0).r);
    vec3 v = vec3(-(zr - zc), -(zu - zc), max(0.02, zc * 0.01));
    return normalize(v);
}

vec3 fetchInputIrradiance(ivec2 coord, ivec2 maxC) {
    ivec2 c = clamp(coord, ivec2(0), maxC);
    vec3 col = sanitizeVec3(texelFetch(uColorTex, c, 0).rgb);
    if (pc.inputIsSrgb != 0u) {
        col = srgbToLinear(col);
    }
    if (pc.hasAlbedo != 0u && pc.demodulateAlbedo != 0u) {
        vec3 alb = max(sanitizeVec3(texelFetch(uAlbedoTex, c, 0).rgb), vec3(0.03));
        col /= alb;
    }
    return col;
}

void main() {
    uvec2 px = gl_GlobalInvocationID.xy;
    if (px.x >= pc.width || px.y >= pc.height) return;

    ivec2 ipx = ivec2(px);
    ivec2 maxC = ivec2(pc.width - 1u, pc.height - 1u);

    vec3 rawCenter = sanitizeVec3(texelFetch(uColorTex, ipx, 0).rgb);
    if (pc.inputIsSrgb != 0u) {
        rawCenter = srgbToLinear(rawCenter);
    }

    float rawDepth = texelFetch(uDepthTex, ipx, 0).r;
    if (isSkyDepth(rawDepth)) {
        float luma = luminance(rawCenter);
        imageStore(uOutIrradianceImg, ipx, vec4(rawCenter, 0.0));
        imageStore(uOutMomentsImg, ipx, vec4(luma, luma * luma, 1.0, pc.farPlane));
        return;
    }

    float zCurr = linearizeDepth(rawDepth);
    vec3 currIrr = fetchInputIrradiance(ipx, maxC);

    // 3x3 neighborhood stats for anti-firefly and history clamping
    vec3 m1Vec = vec3(0.0);
    vec3 m2Vec = vec3(0.0);
    for (int dy = -1; dy <= 1; ++dy) {
        for (int dx = -1; dx <= 1; ++dx) {
            vec3 s = fetchInputIrradiance(ipx + ivec2(dx, dy), maxC);
            m1Vec += s;
            m2Vec += s * s;
        }
    }
    vec3 meanVec = m1Vec / 9.0;
    vec3 stdVec = sqrt(max(vec3(0.0), m2Vec / 9.0 - meanVec * meanVec));

    vec2 mv = texelFetch(uMvecTex, ipx, 0).rg;
    vec2 currUv = (vec2(ipx) + 0.5) / vec2(pc.width, pc.height);
    vec2 prevUv = currUv + mv;

    bool validHistory = (pc.resetHistory == 0u) &&
                        prevUv.x >= 0.0 && prevUv.x <= 1.0 &&
                        prevUv.y >= 0.0 && prevUv.y <= 1.0;

    vec3 prevIrr = currIrr;
    float prevM1 = luminance(currIrr);
    float prevM2 = prevM1 * prevM1;
    float prevLen = 0.0;

    if (validHistory) {
        vec4 prevMom = textureLod(uHistoryMomentsTex, prevUv, 0.0);
        float zPrev = prevMom.w;
        float relDepthDiff = abs(zPrev - zCurr) / max(zCurr, 0.15);
        if (zPrev <= 0.0 || relDepthDiff > 0.12 || isnan(prevMom.x) || isinf(prevMom.x)) {
            validHistory = false;
        } else {
            prevIrr = sanitizeVec3(textureLod(uHistoryColorTex, prevUv, 0.0).rgb);
            // Soft neighborhood variance box clamp: widen gently on static converged frames
            // so 1-SPP path-traced dark rooms do not reset accumulated indirect illumination.
            float clampWidth = mix(2.2, 3.8, clamp(pc.strength, 0.25, 2.5) / 2.5);
            if (prevMom.z >= 4.0 && relDepthDiff < 0.03) {
                clampWidth += min(2.2, (prevMom.z - 3.0) * 0.14);
            }
            vec3 boxMin = max(vec3(0.0), meanVec - stdVec * clampWidth);
            vec3 boxMax = meanVec + stdVec * clampWidth;
            prevIrr = clamp(prevIrr, boxMin, boxMax);

            prevM1 = prevMom.x;
            prevM2 = prevMom.y;
            prevLen = clamp(prevMom.z, 0.0, 32.0);
        }
    }

    float newLen = validHistory ? min(32.0, prevLen + 1.0) : 1.0;
    float maxHist = clamp(pc.temporalBlend, 0.0, 0.96);
    if (validHistory && prevLen >= 6.0 && maxHist >= 0.80) {
        maxHist = min(0.975, maxHist + 0.06);
    }
    float minAlpha = 1.0 - maxHist;
    float alpha = max(minAlpha, 1.0 / newLen);

    vec3 outIrr = validHistory ? mix(prevIrr, currIrr, alpha) : currIrr;
    float lumaCurr = luminance(currIrr);
    float newM1 = mix(prevM1, lumaCurr, alpha);
    float newM2 = mix(prevM2, lumaCurr * lumaCurr, alpha);
    float variance = max(0.0, newM2 - newM1 * newM1);
    if (newLen < 4.0) {
        float lumaStd = dot(stdVec, vec3(0.2126, 0.7152, 0.0722));
        variance = max(variance, lumaStd * lumaStd);
    }

    imageStore(uOutIrradianceImg, ipx, vec4(clamp(outIrr, vec3(0.0), vec3(65504.0)), variance));
    imageStore(uOutMomentsImg, ipx, vec4(newM1, newM2, newLen, zCurr));
}
